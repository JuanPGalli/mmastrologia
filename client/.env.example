VITE_API_URL=https://your-api-service.up.railway.app

# Cloudinary (subida de imágenes desde los paneles admin)
# Cloud name: Dashboard de Cloudinary, arriba de todo
# Upload preset: Settings → Upload → Upload presets → creá uno con Signing Mode = Unsigned
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Calendly (widget de agendamiento en /agendar)
# Tu link de evento: https://calendly.com/tu-usuario/tu-evento
VITE_CALENDLY_URL=

# Google Analytics 4
# Analytics.google.com → Admin → Flujos de datos → tu flujo web → "ID de MEDICIÓN" (G-XXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# Google Search Console — verificación por meta tag
# search.google.com/search-console → Agregar propiedad → Etiqueta HTML → copiá solo el valor de "content"
VITE_GSC_VERIFICATION=
