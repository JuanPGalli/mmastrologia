# Base de datos
MONGO_URI=
JWT_SECRET=

# URL del frontend (sin / al final) — usada para armar los back_url de
# Mercado Pago (Checkout Pro y Preapproval).
FRONTEND_URL=

# Google AI Studio: clave para el Astrólogo Virtual (Gemini). Se saca gratis en
# aistudio.google.com/apikey — modelo actual: gemini-3.5-flash-lite (GA,
# estable), con gemini-3.6-flash como respaldo. Ver historial de cambios de
# modelo en geminiService.ts antes de tocar esto — ya cambió varias veces
# por discontinuaciones/saturación de Google.
GEMINI_API_KEY=

# Mercado Pago — misma cuenta/token para Checkout Pro (pago único de
# consultas) y Preapproval (suscripción mensual del Astrólogo Virtual).
MP_ACCESS_TOKEN=
# Precio mensual de la suscripción, en pesos argentinos, sin puntos ni
# comas (ej: 3000). Ajustar acá cuando cambie la cotización — no está
# hardcodeado en el código a propósito.
MP_SUSCRIPCION_PRECIO_ARS=

# Resend (envío del formulario de contacto)
# API key: dashboard de Resend → API Keys
RESEND_API_KEY=
# A qué email debe llegar cada consulta del formulario
CONTACT_EMAIL_TO=
# Remitente. Con cuenta gratis de Resend sin dominio propio verificado,
# dejá el default (onboarding@resend.dev) — funciona igual para recibir.
RESEND_FROM_EMAIL=MMAstrologia <onboarding@resend.dev>